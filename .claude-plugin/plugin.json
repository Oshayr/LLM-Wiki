{
  "name": "llm-wiki-github",
  "version": "0.1.0",
  "description": "GitHub-Wiki-backed knowledge base for Claude. Stores every note in the target repository's wiki (git-backed), with autonomous ingest, cited reads, and research-on-miss.",
  "author": {
    "name": "Oshayr"
  },
  "homepage": "https://github.com/Oshayr/llm-wiki-github",
  "repository": "https://github.com/Oshayr/llm-wiki-github",
  "license": "MIT",
  "keywords": [
    "wiki",
    "github-wiki",
    "knowledge-base",
    "research",
    "llm",
    "second-brain",
    "claude-code"
  ],
  "agents": [
    "agents/wiki-writer.md",
    "agents/wiki-reader.md",
    "agents/wiki-auditor.md"
  ],
  "skills": [
    "skills/write/SKILL.md",
    "skills/read/SKILL.md",
    "skills/maintain/SKILL.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.py\" || python \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.py\""
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "wiki-mcp": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp_server/wiki-mcp-server.py"]
    }
  }
}

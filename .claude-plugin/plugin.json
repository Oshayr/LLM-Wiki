{
  "name": "llm-wiki",
  "version": "1.0.0",
  "description": "LLM-powered personal wiki — autonomous knowledge base with multi-channel research, ingestion, search, a browsable web UI, and universal data gravity. Saves and retrieves knowledge automatically whenever relevant.",
  "author": {
    "name": "Oshayr"
  },
  "repository": "https://github.com/Oshayr/llm-wiki",
  "license": "MIT",
  "keywords": [
    "wiki",
    "knowledge-base",
    "research",
    "llm",
    "autonomous",
    "second-brain",
    "obsidian",
    "claude-code"
  ],
  "agents": [
    "agents/backlink-manager.md",
    "agents/citation-explorer.md",
    "agents/fact-checker.md",
    "agents/research-loop.md",
    "agents/research-processor.md",
    "agents/search-channel.md",
    "agents/search-orchestrator.md",
    "agents/wiki-auditor.md",
    "agents/wiki-reader.md",
    "agents/wiki-writer.md"
  ],
  "skills": [
    "skills/maintain/SKILL.md",
    "skills/read/SKILL.md",
    "skills/serve/SKILL.md",
    "skills/view/SKILL.md",
    "skills/write/SKILL.md"
  ],
  "rules": [
    "rules/wiki-integration.md",
    "rules/workflow.md"
  ],
  "mcpServers": {
    "wiki-mcp": {
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/mcp/wiki-mcp-server.py"]
    }
  }
}
